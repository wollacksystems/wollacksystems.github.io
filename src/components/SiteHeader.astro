---
// Shared header: canonical brand mark + nav. The Journeyman product surface
// moved to journeymanmfg.com (2026-10-14, extracted into
// wollacksystems/journeyman's site/); the cross-surface slot links it
// externally.
//
// The lockup is mark + wordmark. The wordmark carries the brand name, so the
// mark is decorative to assistive tech; see src/lib/brand.ts for the mark and
// the documented small-size variant it renders.
import BrandMark from './BrandMark.astro';

const walkthroughSubject = 'Walkthrough%20request';
---

<header class="site-header">
  <div class="container header-inner">
    <div class="brand">
      <a href="/">
        <BrandMark class="brand-mark" size={30} />
        <span class="brand-name">Wollack&nbsp;Systems</span>
      </a>
    </div>
    <nav class="site-nav" aria-label="Primary navigation">
      <div class="desktop-nav-links">
        <a href="https://journeymanmfg.com/">Journeyman</a>
        <a href="/about/">Who</a>
        <a href="/#mission">Why</a>
        <a href="/#how">How</a>
      </div>
      <details class="mobile-nav">
        <summary>Menu</summary>
        <div class="mobile-nav-links">
          <a href="https://journeymanmfg.com/">Journeyman</a>
          <a href="/about/">Who</a>
          <a href="/#mission">Why</a>
          <a href="/#how">How</a>
          <a class="mobile-nav-cta" href={`mailto:willwollack@gmail.com?subject=${walkthroughSubject}`}
            >Book a walkthrough</a
          >
        </div>
      </details>
      <a class="btn btn-primary btn-small nav-cta" href={`mailto:willwollack@gmail.com?subject=${walkthroughSubject}`}
        >Book a walkthrough</a
      >
    </nav>
  </div>
</header>
