---
// Journeyman product page — "Rust & Iron" variant of the Industrial Editorial
// design system (see DESIGN.md). The theme override rides on
// <body data-theme="journeyman"> via BaseLayout.
import BaseLayout from '../layouts/BaseLayout.astro';
import { productJourneyman, breadcrumbJourneyman } from '../lib/schema';
---

<BaseLayout
  title="Journeyman, a Wollack Systems product"
  description="Journeyman records how your best operators work, in their own words, and turns it into a searchable record the plant keeps and can train on."
  theme="journeyman"
  path="/journeyman"
  jsonLd={[productJourneyman(), breadcrumbJourneyman()]}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Journeyman, a product of Wollack Systems</p>
        <h1>The work happens in their hands. The knowledge should live on in writing.</h1>
        <p class="lede">
          Journeyman records how your best operators work, in their own words. Your plant owns the
          recordings, and the written record is yours to keep.
        </p>
        <div class="cta-row">
          <a
            class="btn btn-primary"
            href="mailto:willwollack@gmail.com?subject=Journeyman%20walkthrough%20request"
            >Book a walkthrough</a
          >
          <a class="btn btn-ghost" href="/journeyman#engage">See how an engagement runs</a>
        </div>
      </div>

      <aside class="invoice-card" aria-label="What a Journeyman capture produces">
        <div class="invoice-head">THE DELIVERABLE</div>
        <table>
          <tr><td>Written record of every fix</td><td class="num">YES</td></tr>
          <tr><td>Replayable, step by step</td><td class="num">YES</td></tr>
          <tr><td>In the operator's own words</td><td class="num">YES</td></tr>
          <tr class="invoice-divider"><td colspan="2">After we deliver:</td></tr>
          <tr><td>Yours to use and build on</td><td class="num">YES</td></tr>
          <tr class="invoice-total">
            <td>Who owns the recordings</td><td class="num">YOUR PLANT</td>
          </tr>
        </table>
        <p class="invoice-note">
          No screens, no busywork for the operator. They just do the job.
        </p>
      </aside>
    </div>
  </section>

  <!-- What it is -->
  <section class="section section-tinted" id="product">
    <div class="container">
      <h2>What Journeyman is</h2>
      <p class="section-close">
        Apprenticeship has one limit: an expert can stand next to one person at a time. Journeyman
        captures it once, and serves the whole plant.
      </p>
      <div class="grid-4">
        <div class="card">
          <h3>In their words</h3>
          <p>Recorded from the people who do the work: every fix, every trick, every reason.</p>
        </div>
        <div class="card">
          <h3>Written the same week</h3>
          <p>Six hours of explanation becomes a searchable record. No shelf of unlabeled tapes.</p>
        </div>
        <div class="card">
          <h3>Replayable anywhere</h3>
          <p>Walk a new hire through any task, or replay it hands-free on the floor.</p>
        </div>
        <div class="card">
          <h3>Yours, for good</h3>
          <p>Your plant owns the recordings, and the written record is yours to use and build on.</p>
        </div>
      </div>
      <div class="accent-callout">
        <p>
          What we learn beyond your floor travels de-identified: no drawings, no part numbers, no
          names. We commit never to re-identify it.
        </p>
      </div>
    </div>
  </section>

  <!-- How an engagement runs -->
  <section class="section" id="engage">
    <div class="container">
      <h2>How an engagement runs</h2>
      <ol class="steps">
        <li>
          <h3>A walkthrough, then a quote.</h3>
          <p>
            We walk your floor and find who carries the knowledge. Firm quote in days: half up front,
            the rest on delivery.
          </p>
        </li>
        <li>
          <h3>Capture sessions, on their schedule.</h3>
          <p>
            Off-the-shelf gear: a mic, a chest or helmet mount, and a camera on the machine. The
            operator works normally and talks us through it.
          </p>
        </li>
        <li>
          <h3>We turn talk into a written record.</h3>
          <p>
            Every session becomes a searchable document in the operator's own words. No backlog, no
            missing context.
          </p>
        </li>
        <li>
          <h3>Tweaks, then done.</h3>
          <p>We refine until it reads right for your floor. Then it's yours.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- For your floor -->
  <section class="section section-tinted" id="for-your-floor">
    <div class="container">
      <h2>Built for plants of 300&ndash;500 people</h2>
      <div class="grid-3">
        <div class="fact">
          <div class="fact-number">300&ndash;500</div>
          <p>person plants, not Fortune 500s. One expert's retirement slows the line.</p>
        </div>
        <div class="fact">
          <div class="fact-number">Zero screens</div>
          <p>for the operators. They wear a mic and work; the recording takes the notes.</p>
        </div>
        <div class="fact">
          <div class="fact-number">Both languages</div>
          <p>we speak operator and manager. We get the knowledge and make the business case.</p>
        </div>
      </div>
      <div class="accent-callout">
        <p>The people who know are still on the payroll. Capture what they know while they are.</p>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section" id="pricing">
    <div class="container pricing-wrap">
      <h2>Simple to start</h2>
      <p class="price-anchor"><strong>A firm quote, days after the walkthrough.</strong></p>
      <p class="price-sub">
        The capture fee is quoted per project. Half up front to cover the gear, the balance on
        delivery. Extra experts and extra days are priced up front, in writing.
      </p>
      <div class="cta-row cta-center">
        <a
          class="btn btn-primary"
          href="mailto:willwollack@gmail.com?subject=Journeyman%20walkthrough%20request"
          >Book a walkthrough</a
        >
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section-paper" id="book">
    <div class="container">
      <h2>Your best operator's knowledge<br />is one capture from becoming a company asset.</h2>
      <p class="section-close-ink">
        One conversation tells you what capture would look like on your floor.
      </p>
      <div class="cta-row cta-center">
        <a
          class="btn btn-primary"
          href="mailto:willwollack@gmail.com?subject=Journeyman%20walkthrough%20request"
          >Book a walkthrough</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
