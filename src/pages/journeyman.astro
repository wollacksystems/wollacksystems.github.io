---
// Journeyman product page — "Rust & Iron" variant of the Industrial Editorial
// design system (see DESIGN.md). The theme override rides on
// <body data-theme="journeyman"> via BaseLayout.
import BaseLayout from '../layouts/BaseLayout.astro';
import AskLibraryDemo from '../components/AskLibraryDemo.astro';
import { productJourneyman, breadcrumbJourneyman } from '../lib/schema';
---

<BaseLayout
  title="Journeyman, a Wollack Systems product"
  description="Journeyman records how your best operators work, in their own words, and turns it into a library your plant can search, ask questions of, and train from."
  theme="journeyman"
  path="/journeyman"
  jsonLd={[productJourneyman(), breadcrumbJourneyman()]}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Journeyman, a product of Wollack Systems</p>
        <h1>The work happens in their hands. The knowledge should live on in writing.</h1>
        <p class="lede">
          Journeyman records how your best operators work, in their own words. Your plant owns the
          recordings.
        </p>
        <div class="cta-row">
          <a
            class="btn btn-primary"
            href="mailto:willwollack@gmail.com?subject=Journeyman%20walkthrough%20request"
            >Book a walkthrough</a
          >
          <a class="btn btn-ghost" href="/journeyman/#engage">See how an engagement runs</a>
        </div>
      </div>

      <aside class="invoice-card" aria-label="What a Journeyman capture produces">
        <div class="invoice-head">THE DELIVERABLE</div>
        <table>
          <tr><td>Written record of every fix</td><td class="num">YES</td></tr>
          <tr><td>Replayable, step by step</td><td class="num">YES</td></tr>
          <tr><td>In the operator's own words</td><td class="num">YES</td></tr>
          <!-- No "yours to use and build on" row: the card below spells that
               license out in full, and the row before it already says who owns
               the recordings. -->
          <tr class="invoice-divider"><td colspan="2">After we deliver:</td></tr>
          <tr><td>Ask it questions</td><td class="num">YES</td></tr>
          <tr class="invoice-total">
            <td>Who owns the recordings</td><td class="num">YOUR PLANT</td>
          </tr>
        </table>
        <p class="invoice-note">
          No screens. No busywork. They just do the job.
        </p>
      </aside>
    </div>
  </section>

  <!-- What it is -->
  <section class="section section-tinted" id="product">
    <div class="container">
      <h2>What Journeyman is</h2>
      <p class="section-close">
        Apprenticeship has one limit: one expert, one person at a time. Journeyman captures it once
        and serves the whole plant.
      </p>
      <!-- Three cards, not four: "In their words" was the H1, the lede, the invoice
           row, and step 03 of the engagement, all saying it again. -->
      <div class="grid-4">
        <div class="card">
          <h3>Written the same week</h3>
          <p>Six hours of explanation becomes a searchable record, not a shelf of tapes.</p>
        </div>
        <div class="card">
          <h3>Replayable anywhere</h3>
          <p>Walk a new hire through any task, or replay it hands-free on the floor.</p>
        </div>
        <div class="card">
          <h3>Yours, for good</h3>
          <p>Your plant owns the recordings. The written record is yours to use and build on.</p>
        </div>
      </div>
      <div class="accent-callout">
        <p>
          Beyond your floor, what we learn travels de-identified: no drawings, no part numbers, no
          names. We never re-identify it.
        </p>
      </div>
    </div>
  </section>

  <!-- The library: the flagship surface, so it lands here, right after what
       the product is — and the demo is the proof of the claim above it. The
       demo answers from a scripted sample corpus with no network and no model
       (src/lib/library-demo.ts), so the section's three claims are shown
       rather than described: ask it in plain language, every answer names the
       segment it came from, and the panel wears the plant's name. Amounts and
       named-user counts stay unquoted: Part 1 of the Knowledge Capture
       Agreement leaves them to the quote. -->
  <section class="section" id="library">
    <div class="container">
      <h2>Ask Journeyman</h2>
      <p class="section-close">
        Not a document you file. A library you can ask.
      </p>
      <AskLibraryDemo />
      <div class="accent-callout">
        <p>Your library arrives through your own tunnel, which reaches nothing but your data.</p>
      </div>
    </div>
  </section>

  <!-- How an engagement runs -->
  <section class="section section-tinted" id="engage">
    <div class="container">
      <h2>How an engagement runs</h2>
      <ol class="steps">
        <li>
          <h3>A walkthrough, then a quote.</h3>
          <p>We find who carries the knowledge and write the quote in days.</p>
        </li>
        <li>
          <h3>Capture sessions, on their schedule.</h3>
          <p>
            Off-the-shelf gear: a mic, a chest or helmet mount, a camera on the machine. The operator
            works and talks us through it.
          </p>
        </li>
        <li>
          <h3>We turn talk into a written record.</h3>
          <p>
            Every session becomes a searchable document in the operator's own words. No backlog, no
            missing context.
          </p>
        </li>
        <li>
          <h3>Tweaks, then done.</h3>
          <p>We refine until it reads right. Then it's yours.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Trust: the recording and consent commitments, already binding in the
       Knowledge Capture Agreement (Sections 4.3–4.5 and Attachment B). Said
       here because the people being recorded — and the managers who answer
       for it — read this page too; it is why an operator says yes. -->
  <section class="section section-tinted" id="trust">
    <div class="container">
      <h2>Recorded with consent, guarded by contract</h2>
      <p class="section-close">
        Every commitment below is already in the capture agreement we sign, not a promise we
        improvise on site.
      </p>
      <div class="grid-3">
        <div class="card">
          <h3>The operator stays in control</h3>
          <p>Anyone recorded can pause at any time, for any reason, and strike a segment within seven days.</p>
        </div>
        <div class="card">
          <h3>No biometrics, ever</h3>
          <p>No voiceprints, no face templates. Transcripts name people by role, never by matching.</p>
        </div>
        <div class="card">
          <h3>Not used against the crew</h3>
          <p>Recordings serve training — not evaluations, discipline, pay, or termination — unless the law or a revealed safety hazard requires action.</p>
        </div>
        <div class="card">
          <h3>Consent is the boundary</h3>
          <p>A bystander who wanders in is cut or blurred. Their words are never transcribed or indexed.</p>
        </div>
        <div class="card">
          <h3>Locked down and logged</h3>
          <p>Encrypted in transit and at rest. Named people only, every access logged, list available on request.</p>
        </div>
        <div class="card">
          <h3>Deleted on schedule</h3>
          <p>Recordings go when the agreement's period ends. Deliverables last the hosting term, then deletion on request.</p>
        </div>
      </div>
      <div class="accent-callout">
        <p>Signs at every entrance and camera, in the languages your floor speaks. A visible indicator shows when recording is on. Recording stops where consent does.</p>
      </div>
    </div>
  </section>

  <!-- For your floor -->
  <section class="section" id="for-your-floor">
    <div class="container">
      <h2>Built for plants of 300&ndash;500 people</h2>
      <div class="grid-3">
        <div class="fact">
          <div class="fact-number">300&ndash;500</div>
          <p>person plants, not Fortune 500s. One expert's retirement slows the line.</p>
        </div>
        <div class="fact">
          <div class="fact-number">Zero screens</div>
          <p>for the operators. They wear a mic; the record takes the notes.</p>
        </div>
        <div class="fact">
          <div class="fact-number">Both languages</div>
          <p>we speak operator and manager: the knowledge, and the business case.</p>
        </div>
      </div>
      <div class="accent-callout">
        <p>The people who know are still on the payroll. Capture what they know while they are.</p>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section section-tinted" id="pricing">
    <div class="container pricing-wrap">
      <h2>Simple to start</h2>
      <!-- The anchor names both fee halves instead of restating step 01's quote,
           which is the one thing a buyer pricing this needs up front. -->
      <p class="price-anchor"><strong>Capture once. Library monthly.</strong></p>
      <p class="price-sub">
        Capture is quoted per project: half up front, the balance on delivery, extras priced in
        writing. Library access is monthly, from delivery, for the named users in your agreement.
        Thirty days' notice ends it.
      </p>
      <div class="cta-row cta-center">
        <a
          class="btn btn-primary"
          href="mailto:willwollack@gmail.com?subject=Journeyman%20walkthrough%20request"
          >Book a walkthrough</a
        >
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section-paper" id="book">
    <div class="container">
      <h2>Your best operator's knowledge<br />is one capture from becoming a company asset.</h2>
      <!-- Distinct from the landing page's close on purpose: that one is the same
           invitation, and this page can ask the sharper question. -->
      <p class="section-close-ink">
        Tell us who carries the knowledge. We'll tell you what capture would take.
      </p>
      <div class="cta-row cta-center">
        <a
          class="btn btn-primary"
          href="mailto:willwollack@gmail.com?subject=Journeyman%20walkthrough%20request"
          >Book a walkthrough</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
