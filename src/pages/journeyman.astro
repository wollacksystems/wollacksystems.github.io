---
// Journeyman product page — "Rust & Iron" variant of the Industrial Editorial
// design system (see DESIGN.md). The theme override rides on
// <body data-theme="journeyman"> via BaseLayout.
import BaseLayout from '@/layouts/BaseLayout.astro';
import AskLibraryDemo from '@/components/AskLibraryDemo.astro';
import { productJourneyman, breadcrumbJourneyman, videoJourneymanBrag } from '@/lib/schema';
---

<BaseLayout
  title="Journeyman, a Wollack Systems product"
  description="Journeyman records how your best operators work, in their own words, and turns it into a library your plant can search, ask questions of, and train from."
  theme="journeyman"
  path="/journeyman"
  jsonLd={[productJourneyman(), breadcrumbJourneyman(), videoJourneymanBrag()].flatMap((
    entity,
  ) => (entity ? [entity] : []))}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Journeyman, from Wollack Systems</p>
        <h1>Your best operator retires in two years. What they know shouldn't leave with them.</h1>
        <p class="lede">
          Journeyman records how your best people do the job, while they do it. You get it back
          in writing, step by step, in their own words.
        </p>
        <div class="cta-row">
          <a
            class="btn btn-primary"
            href="mailto:willwollack@gmail.com?subject=Journeyman%20walkthrough%20request"
            >Call us to learn more</a
          >
          <a class="btn btn-ghost" href="/journeyman/#library">See how it works on your floor</a>
        </div>
        <p class="cta-note">We come to you. Your crew keeps working.</p>
      </div>

      <aside class="invoice-card" aria-label="What a Journeyman capture produces">
        <div class="invoice-head">THE DELIVERABLE</div>
        <table>
          <tr><td>Written record of every fix</td><td class="num">YES</td></tr>
          <tr><td>Replayable, step by step</td><td class="num">YES</td></tr>
          <tr><td>In the operator's own words</td><td class="num">YES</td></tr>
          <!-- No "yours to use and build on" row: the card below spells that
               license out in full, and the row before it already says who owns
               the recordings. -->
          <tr class="invoice-divider"><td colspan="2">After we deliver:</td></tr>
          <tr><td>Ask it questions</td><td class="num">YES</td></tr>
          <tr class="invoice-total">
            <td>Who owns the recordings</td><td class="num">YOUR PLANT</td>
          </tr>
        </table>
        <p class="invoice-note">
          No screens. No busywork. They just do the job.
        </p>
      </aside>
    </div>
  </section>

  <!-- The library: the flagship surface, so it lands second, right after the
       hero — the page's proof before its pitch. Left alone it types through
       its four questions on loop until the first click or keypress. The
       demo answers from a scripted sample corpus with no network and no model
       (src/lib/library-demo.ts), so the section's three claims are shown
       rather than described: ask it in plain language, every answer names the
       segment it came from, and the panel wears the plant's name. Amounts and
       named-user counts stay unquoted: Part 1 of the Knowledge Capture
       Agreement leaves them to the quote. -->
  <section class="section" id="library">
    <div class="container">
      <h2>Ask Journeyman</h2>
      <p class="section-close">
        Not a document you file. A library you can ask.
      </p>
      <AskLibraryDemo />
      <div class="accent-callout">
        <p>Your library arrives through your own tunnel, which reaches nothing but your data.</p>
      </div>
    </div>
  </section>

  <!-- For your floor -->
  <section class="section" id="for-your-floor">
    <div class="container">
      <h2>Built for plants of 50&ndash;500 people</h2>
      <div class="grid-3">
        <div class="fact">
          <div class="fact-number">50&ndash;500</div>
          <p>person plants, not Fortune 500s. One expert's retirement slows the line.</p>
        </div>
        <div class="fact">
          <div class="fact-number">Zero screens</div>
          <p>for the operators. They wear a mic; the record takes the notes.</p>
        </div>
        <div class="fact">
          <div class="fact-number">Both languages</div>
          <p>we speak operator and manager: the knowledge, and the business case.</p>
        </div>
      </div>
      <div class="accent-callout">
        <p>The people who know are still on the payroll. Capture what they know while they are.</p>
      </div>
    </div>
  </section>

  <!-- The launch film (#17): 34 seconds, six scenes, and the deployed
       endpoint's own output on screen for nearly half of it. A plain
       <video> — no script, so the site's one-script contract holds; the
       poster carries the first paint, and it starts on its own — muted and looping,
       by attribute alone, so the one-script contract still holds. -->
  <section class="section" id="film">
    <div class="container">
      <h2>See it in 34 seconds</h2>
      <p class="section-close">
        The capture rig, the pipeline, and the live library answering a real question.
      </p>
      <figure class="film-frame">
        <video
          controls
          playsinline
          autoplay muted loop preload="metadata"
          poster="/journeyman/brag-poster.png"
          aria-label="Journeyman launch film: the capture rig, the pipeline, and the live library answering a real question.">
          <source src="/journeyman/brag.mp4" type="video/mp4" />
          <a href="https://github.com/wollacksystems/wollacksystems.github.io/issues/17">
            Watch the launch film on GitHub
          </a>
        </video>
        <figcaption>
          The film's answer scenes are this endpoint's own bytes, replayed at native resolution
          &mdash; no mocked responses, no narrator.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section-paper" id="book">
    <div class="container">
      <h2>Your best operator's knowledge<br />is one capture from becoming a company asset.</h2>
      <!-- Distinct from the landing page's close on purpose: that one is the same
           invitation, and this page can ask the sharper question. -->
      <p class="section-close-ink">
        Tell us who carries the knowledge. We'll tell you what capture would take.
      </p>
      <div class="cta-row cta-center">
        <a
          class="btn btn-primary"
          href="mailto:willwollack@gmail.com?subject=Journeyman%20walkthrough%20request"
          >Book a walkthrough</a
        >
        <a class="btn btn-ghost" href="/journeyman/guides/#engage">See how an engagement runs</a>
      </div>
    </div>
  </section>
</BaseLayout>
