---
// Journeyman guides — the detail bands moved off /journeyman (October 5
// partner feedback): a first visit should not stop to study these. The product
// page keeps the proof, the fit, the film, and the ask; what the product is,
// how an engagement runs, the consent terms, and pricing live here, linked
// from the header nav ("How it works" and "Pricing") and the closing CTA.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { productJourneyman, journeymanGuidesPage, breadcrumbJourneymanGuides } from '@/lib/schema';
---

<BaseLayout
  title="Journeyman guides, a Wollack Systems product"
  description="What Journeyman is, how an engagement runs, what the capture agreement guarantees, and what it costs — the detail behind the Journeyman product page."
  theme="journeyman"
  path="/journeyman/guides"
  jsonLd={[productJourneyman(), journeymanGuidesPage(), breadcrumbJourneymanGuides()]}
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Journeyman, from Wollack Systems</p>
      <h1>How Journeyman works</h1>
      <p class="lede">
        The detail behind the product page: what the written record is, how an engagement runs, what the
        agreement guarantees, and what it costs.
      </p>
      <div class="cta-row">
        <a class="btn btn-ghost" href="/journeyman/">Back to the Journeyman page</a>
      </div>
    </div>
  </section>
  <!-- What it is -->
  <section class="section section-tinted" id="product">
    <div class="container">
      <h2>What Journeyman is</h2>
      <p class="section-close">
        Apprenticeship has one limit: one expert trains one person at a time. Journeyman captures
        it once and serves the whole plant.
      </p>
      <!-- Three cards, not four: "In their words" was the H1, the lede, the invoice
           row, and step 03 of the engagement, all saying it again. -->
      <div class="grid-4">
        <div class="card">
          <h3>Written the same week</h3>
          <p>Six hours of explanation becomes a searchable record, not a shelf of tapes.</p>
        </div>
        <div class="card">
          <h3>Replayable anywhere</h3>
          <p>Walk a new hire through any task, or replay it hands-free on the floor.</p>
        </div>
        <div class="card">
          <h3>Yours, for good</h3>
          <p>Your plant owns the recordings. The written record is yours to use and build on.</p>
        </div>
      </div>
      <div class="accent-callout">
        <p>
          Beyond your floor, what we learn travels de-identified: no drawings, no part numbers, no
          names. We keep the general technique and use it with other plants. We never re-identify
          it.
        </p>
      </div>
    </div>
  </section>

  <!-- How an engagement runs -->
  <section class="section section-tinted" id="engage">
    <div class="container">
      <h2>How an engagement runs</h2>
      <ol class="steps">
        <li>
          <h3>A walkthrough, then a quote.</h3>
          <p>We find who carries the knowledge and write the quote in days.</p>
        </li>
        <li>
          <h3>Capture sessions, on their schedule.</h3>
          <p>
            Off-the-shelf gear: a mic, a chest or helmet mount, a camera on the machine. The operator
            works and talks us through it.
          </p>
        </li>
        <li>
          <h3>We turn talk into a written record.</h3>
          <p>
            Every session becomes a searchable document in the operator's own words. No backlog, no
            missing context.
          </p>
        </li>
        <li>
          <h3>Tweaks, then done.</h3>
          <p>We refine until it reads right. Then it's yours.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Trust: the recording and consent commitments, already binding in the
       Knowledge Capture Agreement (Sections 4.3–4.5 and Attachment B). Said
       here because the people being recorded — and the managers who answer
       for it — read this page too; it is why an operator says yes. -->
  <section class="section section-tinted" id="trust">
    <div class="container">
      <h2>Recorded with consent, guarded by contract</h2>
      <p class="section-close">
        Every commitment below is already in the capture agreement we sign, not a promise we
        improvise on site.
      </p>
      <div class="grid-3">
        <div class="card">
          <h3>The operator stays in control</h3>
          <p>Anyone recorded can pause at any time, for any reason, and strike a segment within seven days.</p>
        </div>
        <div class="card">
          <h3>No biometrics, ever</h3>
          <p>No voiceprints, no face templates. Transcripts name people by role, never by matching.</p>
        </div>
        <div class="card">
          <h3>Not used against the crew</h3>
          <p>Recordings serve training — not evaluations, discipline, pay, or termination — unless the law or a revealed safety hazard requires action.</p>
        </div>
        <div class="card">
          <h3>Consent is the boundary</h3>
          <p>A bystander who wanders in is cut or blurred. Their words are never transcribed or indexed.</p>
        </div>
        <div class="card">
          <h3>Locked down and logged</h3>
          <p>Encrypted in transit and at rest. Named people only, every access logged, list available on request.</p>
        </div>
        <div class="card">
          <h3>Deleted on schedule</h3>
          <p>Recordings go when the agreement's period ends. Deliverables last the hosting term, then deletion on request.</p>
        </div>
      </div>
      <div class="accent-callout">
        <p>Signs at every entrance and camera, in the languages your floor speaks. A visible indicator shows when recording is on. Recording stops where consent does.</p>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section section-tinted" id="pricing">
    <div class="container pricing-wrap">
      <h2>Simple to start</h2>
      <!-- The anchor names both fee halves instead of restating step 01's quote,
           which is the one thing a buyer pricing this needs up front. -->
      <p class="price-anchor"><strong>Capture once. Library monthly.</strong></p>
      <p class="price-sub">
        Capture is quoted per project: half up front, the balance on delivery, extras priced in
        writing. Library access is monthly, from delivery, for the named users in your agreement.
        Thirty days' notice ends it.
      </p>
      <div class="cta-row cta-center">
        <a
          class="btn btn-primary"
          href="mailto:willwollack@gmail.com?subject=Journeyman%20walkthrough%20request"
          >Book a walkthrough</a
        >
      </div>
    </div>
  </section>


</BaseLayout>
