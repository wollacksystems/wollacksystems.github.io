---
// About page — the founder behind the company (blue/cobalt theme).
//
// Each beat of the story is told once. The landing page owns the origin and the
// pitch ("One pitch found a cofounder"); this page carries only what the landing
// page doesn't: what Will listens for, and who writes the record down. Product
// detail lives on /journeyman (the "Rust & Iron" variant page).
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  organization,
  personWillWollack,
  aboutPage,
  breadcrumbAbout,
  FOUNDER_PORTRAIT,
  COFOUNDER_PORTRAIT,
} from '../lib/schema';

// FOUNDER_PORTRAIT is null until public/will-wollack.png exists; the hero
// renders a typographic placeholder plate in the meantime. COFOUNDER_PORTRAIT
// follows the same drop-in convention (public/ethan-davidson.png).
const portraitSrc = FOUNDER_PORTRAIT;
const cofounderSrc = COFOUNDER_PORTRAIT;
---

<BaseLayout
  title="About Will Wollack, Wollack Systems"
  description="What Will Wollack listens for in every room, and the engineer who writes the record down. The founder and cofounder behind Wollack Systems."
  path="/about"
  jsonLd={[organization(), personWillWollack(), aboutPage(), breadcrumbAbout()]}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">About Wollack Systems</p>
        <h1>
          The founder came up in the field and decided the knowledge shouldn't die on schedule.
        </h1>
        <p class="lede">
          Will Wollack came to manufacturing through the room, not a spreadsheet: trade events, shop
          tours, cold handshakes. That is still the method: every pitch in person, every walkthrough
          on the floor.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="mailto:willwollack@gmail.com?subject=Walkthrough%20request"
            >Book a walkthrough</a
          >
          <a class="btn btn-ghost" href="/journeyman">See what's being built</a>
        </div>
      </div>

      <figure class="portrait-plate">
        <div class="portrait-frame">
          {
            portraitSrc ? (
              <img
                class="portrait-img"
                src={portraitSrc}
                alt="Will Wollack, founder of Wollack Systems"
                width="600"
                height="600"
                loading="eager"
              />
            ) : (
              <div
                class="portrait-placeholder"
                role="img"
                aria-label="Portrait of Will Wollack — photo forthcoming"
              >
                <span class="portrait-mark">&#9881;</span>
                <span class="portrait-initials">W.&thinsp;W.</span>
                <span class="portrait-slug">Photo forthcoming</span>
              </div>
            )
          }
        </div>
        <figcaption class="portrait-caption">
          <span class="portrait-name">Will Wollack</span>
          <span class="portrait-role">Founder, Wollack Systems</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- What Will listens for -->
  <section class="section section-tinted" id="who">
    <div class="container">
      <h2>What Will listens for.</h2>
      <p class="lede">
        Will listens first. Every room has two things worth hearing: the repair nobody could explain,
        and the machinist nobody can replace.
      </p>
      <div class="accent-callout">
        <p>
          The same problem showed up in every room. So Will stopped pitching it and started building
          the record.
        </p>
      </div>
    </div>
  </section>

  <!-- Who writes it down: what the pitch found, which the landing page only names. -->
  <section class="section" id="team">
    <div class="container">
      <h2>Who writes it down.</h2>
      <div class="split-with-plate">
        <div>
          <p class="lede">Will finds the rooms and runs the capture. Ethan builds the platform.</p>
          <p>
            Ethan Davidson, a software engineer formerly of Google, is the engineering half of
            Wollack Systems and the builder of Journeyman. Neither half works alone: someone has to
            stand in the room, and someone has to write down what the room knows.
          </p>
        </div>
        {
          cofounderSrc && (
            <figure class="cofounder-plate">
              <img
                class="cofounder-img"
                src={cofounderSrc}
                alt="Ethan Davidson, cofounder of Wollack Systems"
                width="240"
              />
              <figcaption class="cofounder-caption">
                <span class="cofounder-name">Ethan Davidson</span>
                <span class="cofounder-role">Cofounder, Wollack Systems</span>
              </figcaption>
            </figure>
          )
        }
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section-paper" id="book">
    <div class="container">
      <h2>Start with the operator you can't afford to lose.</h2>
      <p class="section-close-ink">
        Tell us who it is. We'll tell you what recording them takes.
      </p>
      <div class="cta-row cta-center">
        <a class="btn btn-primary" href="mailto:willwollack@gmail.com?subject=Walkthrough%20request"
          >Book a walkthrough</a
        >
        <a class="btn btn-ghost" href="https://etok.me/" target="_blank" rel="noopener"
          >Meet the cofounder</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero portrait — the "document plate" motif: a framed plate on the dark
     canvas, like the invoice card and the OG image composition. Hard corners,
     hairline rules, blue reserved for the accent tick. */
  .portrait-plate {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    padding: 14px;
    max-width: 420px;
    justify-self: end;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
  }

  .portrait-frame {
    aspect-ratio: 1 / 1;
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border-subtle);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(100%) contrast(1.05);
    transition: filter 0.25s ease;
  }

  /* Editorial reveal: color on hover, like a photo coming off the press. */
  .portrait-plate:hover .portrait-img {
    filter: none;
  }

  /* Typographic placeholder until a real photo lands. */
  .portrait-placeholder {
    display: grid;
    place-items: center;
    gap: 4px;
    text-align: center;
    padding: 24px;
  }

  .portrait-mark {
    color: var(--color-accent-blue);
    font-size: 1.4rem;
  }

  .portrait-initials {
    font-family: var(--font-editorial);
    font-size: 6rem;
    line-height: 1;
    color: var(--color-text-primary);
  }

  .portrait-slug {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: 10px;
    margin-top: 12px;
  }

  .portrait-caption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 4px 2px;
  }

  .portrait-name {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-primary);
  }

  /* The accent-rule motif from the pull quotes, shrunk to a tick. */
  .portrait-name::before {
    content: '';
    display: inline-block;
    width: 18px;
    height: 3px;
    background: var(--color-accent-blue);
    margin-right: 10px;
    vertical-align: middle;
  }

  .portrait-role {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  @media (max-width: 820px) {
    .portrait-plate {
      justify-self: center;
      width: 100%;
      max-width: 380px;
    }
  }

  /* Cofounder portrait beside the team copy: a smaller cousin of the hero
     plate, same frame language. Both portraits render square (1:1); the
     CSS aspect-ratio crops whatever the source's native shape is via
     object-fit: cover, top-anchored so faces survive the crop. */
  .split-with-plate {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  /* First paragraph of the split carries the sentence that lands it. */
  .split-with-plate .lede {
    margin-bottom: 14px;
  }

  /* Below 700px the split is a single column, so the plate centers and
     grows slightly, matching the hero plate's narrow-viewport behavior.
     The 700px override for the two-column layout sits after the base
     plate rule; source order decides the cascade at equal specificity. */
  .cofounder-plate {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    padding: 8px;
    width: 220px;
    justify-self: center;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3);
  }

  @media (min-width: 700px) {
    .split-with-plate {
      grid-template-columns: 1fr 180px;
      align-items: center;
      column-gap: 32px;
    }

    .cofounder-plate {
      justify-self: end;
      width: 180px;
    }
  }

  .cofounder-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: top;
    display: block;
    filter: grayscale(100%) contrast(1.05);
    transition: filter 0.25s ease;
  }

  .cofounder-plate:hover .cofounder-img {
    filter: none;
  }

  .cofounder-caption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px 2px 2px;
  }

  /* The caption is a fixed 180px plate at 700px and up (see DESIGN.md), and
     upper-case mono with tracking overflows it: "COFOUNDER, WOLLACK SYSTEMS"
     runs ~180px inside a 163px box. So the caption wraps like the hero
     plate's does rather than pushing text past the frame. */
  .cofounder-name {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    text-wrap: pretty;
  }

  .cofounder-name::before {
    content: '';
    display: inline-block;
    width: 14px;
    height: 3px;
    background: var(--color-accent-blue);
    margin-right: 8px;
    vertical-align: middle;
  }

  .cofounder-role {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }
</style>
